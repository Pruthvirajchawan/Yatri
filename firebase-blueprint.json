{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data and preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "Full name" },
        "email": { "type": "string", "description": "Email address" },
        "avatar": { "type": "string", "description": "Avatar URL or preset identifier" },
        "location": { "type": "string", "description": "Home city/country" },
        "memberSince": { "type": "string", "description": "Joining date" },
        "savedDestinationIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Saved destination IDs"
        },
        "travelStyle": { "type": "string", "description": "Preferred travel style" },
        "createdAt": { "type": "string", "description": "Creation ISO timestamp" },
        "updatedAt": { "type": "string", "description": "Last update ISO timestamp" }
      },
      "required": ["id", "name", "email"]
    },
    "Trip": {
      "title": "Trip",
      "description": "A customized itinerary or trip created by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique trip ID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "title": { "type": "string", "description": "Trip title" },
        "destinationSummary": { "type": "string", "description": "Destinations summary" },
        "heroImage": { "type": "string", "description": "Cover photo URL" },
        "status": { "type": "string", "description": "Trip status (Planning, Confirmed, Active, Completed)" },
        "startDate": { "type": "string", "description": "Start date (YYYY-MM-DD)" },
        "endDate": { "type": "string", "description": "End date (YYYY-MM-DD)" },
        "travelersCount": { "type": "number", "description": "Number of travelers" },
        "budgetTotal": { "type": "number", "description": "Total budget in INR" },
        "budgetSpent": { "type": "number", "description": "Spent amount in INR" },
        "currency": { "type": "string", "description": "Currency code" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" }
      },
      "required": ["id", "userId", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles managed by their owner"
    },
    "/trips/{tripId}": {
      "schema": "Trip",
      "description": "Trip itineraries owned by users"
    }
  }
}
